# Nunca commitear .env. Wallet dedicada del agente, con fondos mínimos.
AGENT_PRIVATE_KEY=0x...
# Tag elegido por el equipo (celo_xxxxxxxx)
CELO_ATTRIBUTION_TAG=celo_xxxxxxxx
CELO_RPC_URL=https://forno.celo.org
# URL pública de la agent card (para registrar ERC-8004)
AGENT_URI=https://agente-chasqui-tech-api.vercel.app/agent.json
# Por defecto NO se mueve plata. Para operaciones reales hacen falta las DOS variables (descomentar solo entonces):
# AGENT_MODE=live
# CONFIRM_REAL_PAYMENTS=yes-move-real-money
